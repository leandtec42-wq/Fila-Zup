// Schema do banco de dados - Sistema de Gerenciamento de Filas e Eventos
// Banco: SQLite (o banco inteiro fica em um único arquivo, prisma/dev.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USER — o cliente que cria e administra eventos (tenant)
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  name         String
  companyName  String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events Event[]

  @@index([email])
  @@map("users")
}

// Status possíveis: DRAFT, ACTIVE, PAUSED, CLOSED
// (SQLite não suporta enum nativo do Prisma, por isso viram String)

// ---------------------------------------------------------------------------
// EVENT — um evento pertence a um usuário (tenant) e possui uma fila própria
// ---------------------------------------------------------------------------
model Event {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  date        DateTime
  startTime   String // HH:mm
  endTime     String // HH:mm
  location    String?
  maxParticipants Int?
  status      String   @default("DRAFT")
  publicSlug  String   @unique

  // permite ou não que um participante já COMPLETED entre novamente na fila
  allowReentryAfterCompletion Boolean @default(false)

  // controle interno do próximo número sequencial da fila (evita reuso)
  lastQueueNumber Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  queueEntries QueueEntry[]
  actions      QueueAction[]
  messages     WhatsAppMessage[]

  @@index([userId])
  @@index([publicSlug])
  @@index([status])
  @@map("events")
}

// Status possíveis: WAITING, CALLED, IN_SERVICE, COMPLETED, SKIPPED, CANCELLED

// ---------------------------------------------------------------------------
// QUEUE_ENTRY — um participante dentro da fila de um evento específico
// ---------------------------------------------------------------------------
model QueueEntry {
  id          String @id @default(cuid())
  eventId     String
  queueNumber Int
  name        String
  email       String
  phone       String // E.164, ex: +5511999999999
  status      String @default("WAITING")
  consentWhatsApp Boolean @default(true)

  createdAt        DateTime  @default(now())
  calledAt         DateTime?
  serviceStartedAt DateTime?
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actions  QueueAction[]
  messages WhatsAppMessage[]

  // impede duas entradas ativas com o mesmo telefone no mesmo evento
  @@unique([eventId, queueNumber])
  @@index([eventId, status, createdAt])
  @@index([eventId, phone])
  @@index([phone])
  @@map("queue_entries")
}

// ---------------------------------------------------------------------------
// QUEUE_ACTION — trilha de auditoria de tudo que acontece com uma entrada
// ---------------------------------------------------------------------------
model QueueAction {
  id           String   @id @default(cuid())
  queueEntryId String
  eventId      String
  action       String // QUEUE_JOINED, QUEUE_CALLED, SERVICE_STARTED, ...
  metadata     String? // JSON serializado com detalhes extras
  createdAt    DateTime @default(now())

  queueEntry QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([queueEntryId])
  @@map("queue_actions")
}

// Tipos possíveis: QUEUE_JOINED, POSITION_UPDATE, CALLED, COMPLETED
// Status possíveis: PENDING, SENT, FAILED, LOGGED_DEV_MODE

// ---------------------------------------------------------------------------
// WHATSAPP_MESSAGE — histórico de mensagens enviadas via Meta Cloud API
// ---------------------------------------------------------------------------
model WhatsAppMessage {
  id                String    @id @default(cuid())
  queueEntryId      String
  eventId           String
  phone             String
  messageType       String
  status            String    @default("PENDING")
  providerMessageId String?
  error             String?
  payload           String? // JSON enviado à API (sem tokens)
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  queueEntry QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([queueEntryId])
  @@index([status])
  @@map("whatsapp_messages")
}
