# ==========================================================
# BANCO DE DADOS (MySQL)
# ==========================================================
# Exemplo local:      mysql://usuario:senha@localhost:3306/queue_saas
# Exemplo PlanetScale: mysql://usuario:senha@aws.connect.psdb.cloud/queue_saas?sslaccept=strict
# Exemplo Railway:     mysql://usuario:senha@containers-us-west-1.railway.app:1234/railway
DATABASE_URL="mysql://root:password@localhost:3306/queue_saas"

# ==========================================================
# AUTENTICAÇÃO (NextAuth / Auth.js)
# ==========================================================
# Gere um valor aleatório forte com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-forte-e-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Login com Google (crie as credenciais em https://console.cloud.google.com/apis/credentials
# -> "Criar credenciais" -> "ID do cliente OAuth" -> tipo "Aplicativo da Web".
# Em "URIs de redirecionamento autorizados" adicione:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==========================================================
# URL PÚBLICA DA APLICAÇÃO (usada para montar o link /fila/[slug])
# ==========================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================================
# META WHATSAPP CLOUD API
# Veja o passo a passo completo em docs/WHATSAPP.md
# ==========================================================
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION="v21.0"

# Nome do template aprovado no Meta Business Manager usado para a primeira
# mensagem (fora da janela de 24h). Se vazio, o sistema usa mensagem de texto
# livre (só funciona dentro da janela de 24h de uma conversa já iniciada).
META_WHATSAPP_TEMPLATE_NAME="fila_atualizacao"
META_WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"

# ==========================================================
# RATE LIMITING (opcional - janela em segundos e limite de requisições)
# ==========================================================
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
